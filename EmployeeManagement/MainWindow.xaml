<Window x:Class="EmployeeManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmployeeManagement"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="name" HorizontalAlignment="Left" Margin="35,32,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtname" HorizontalAlignment="Left" Margin="83,36,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120"/>
        <Label Content="age" HorizontalAlignment="Left" Margin="232,32,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtage" HorizontalAlignment="Left" Margin="280,36,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120"/>
        <Label Content="department" HorizontalAlignment="Left" Margin="430,32,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtdepartment" HorizontalAlignment="Left" Margin="478,36,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120"/>
        <Label Content="position" HorizontalAlignment="Left" Margin="622,32,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtposition" HorizontalAlignment="Left" Margin="670,36,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120"/>
        <!-- buttons definitions-->
        <Button x:Name="btnadd" Content="Add Employee" HorizontalAlignment="Left" Margin="35,70,0,0" VerticalAlignment="Top" Width="168" Click="btnadd_click"/>
        <Button x:Name="btnupdate" Content="update Employee" HorizontalAlignment="Left" Margin="232,70,0,0" VerticalAlignment="Top" Width="168" Click="btnupdate_click"/>
        <Button x:Name="btndelete" Content="delete Employee" HorizontalAlignment="Left" Margin="430,70,0,0" VerticalAlignment="Top" Width="168" Click="btndelete_click"/>
        <Button x:Name="btnclear" Content="Clear" HorizontalAlignment="Left" Margin="622,70,0,0" VerticalAlignment="Top" Width="168" Click="btnclear_click"/>
        
        <!-- display the employee information-->
        <Label Content="Emploee List" HorizontalAlignment="Left" Margin="35,106,0,0" VerticalAlignment="Top" Width="755" Height="28"/>
        <ListBox x:Name="lstemployees" Margin="35,129,10,203" SelectionChanged="lstemployees_SelectionChanged"/>
<!--d:ItemsSource="{d:SampleData ItemCount=5}"-->
    </Grid>
</Window>
