<Window x:Class="CyberChatbotWPF_Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberChatbotWPF_Example"
        mc:Ignorable="d"
        Title="Cybersecurity awarenes chatbot" Height="450" Width="800" Background="#0F172A"  WindowStartupLocation="CenterScreen">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>
        
        <!-- title -->
        <TextBlock Text="Cybersecurity awarenes chatbot"
            FontSize="28"
            FontWeight="Bold"
            Foreground="LightBlue"
            HorizontalAlignment="Center"
            Margin="0,0,0,10"/>

     <!--ASCII / Cyber banner-->
        <Border Grid.Row="1"
                Background="Black"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock FontFamily="Consolas"
                       FontSize="14"
                       Foreground="Green"
                       TextWrapping="Wrap">

  _____     __           ____                 _ __         ___                                         ___       __ 
 / ___/_ __/ /  ___ ____/ __/__ ______ ______(_) /___ __  / _ |_    _____ ________ ___  ___ ___ ___   / _ )___  / /_
/ /__/ // / _ \/ -_) __/\ \/ -_) __/ // / __/ / __/ // / / __ | |/|/ / _ `/ __/ -_) _ \/ -_|_ / _  / _ \/ __/
\___/\_, /_.__/\__/_/ /___/\__/\__/\_,_/_/ /_/\__/\_, / /_/ |_|__,__/\_,_/_/  \__/_//_/\__/___/___/ /____/\___/\__/ 
    /___/                                        /___/                                                             
            </TextBlock>
        </Border>
        
        <!-- Chat display-->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,10">
            <TextBox x:Name="Chatdisplay" 
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="15"
                     FontFamily="Segoe UI"
                     Background="#E2E8F0"
                     Foreground="Black"
                     BorderThickness="0"
                     Padding="10"/>
        </ScrollViewer>
        <!-- input area section for the user -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>

            </Grid.ColumnDefinitions>

            <TextBox x:Name="Userinput"
                     Grid.Column="0"
                     Height="40"
                     FontSize="15"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"/>

            <Button x:Name="Sendbutton"
                    Grid.Column="1"
                    Content="send"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Sendbutton_click"/>

            <Button x:Name="Clearbutton"
        Grid.Column="2"
        Content="clear Chat"
        Height="40"
        Margin="0,0,10,0"
        Background="#DC2626"
        Foreground="White"
        FontWeight="Bold"
        Click="Clearbutton_click"/>
        </Grid>
    </Grid>
</Window>
