<Window x:Class="FirstGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FirstGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- thus is a single line comment-->
        <!-- -->
        <!--
        this is a multi line comment section
        this example will be used to develop a calculator
        
        
        divide the main screen into coloumbs for easier display and use
        -->
        <Grid.ColumnDefinitions> <!-- open tag -->
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>

        </Grid.ColumnDefinitions> <!-- close tag-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="txtOutput" Grid.Column="4" Grid.Row="0" Margin="5" Text="0"
           HorizontalAlignment="Stretch" VerticalAlignment="Center" IsReadOnly="True"/>

        <!--Add buttons: numbers from 1,2,3, to the last number -->

        <Button Content="1" Grid.Column="0" Grid.Row="1" Margin="5" Click="Number_Click"/>
        <Button Content="2" Grid.Column="1" Grid.Row="1" Margin="5" Click="Number_Click"/>
        <Button Content="3" Grid.Column="2" Grid.Row="1" Margin="5" Click="Number_Click"/>
        <Button Content="+" Grid.Column="3" Grid.Row="1" Margin="5" Click="Number_Click"/>
        <Button Content="4" Grid.Column="0" Grid.Row="2" Margin="5" Click="Number_Click"/>
        <Button Content="5" Grid.Column="1" Grid.Row="2" Margin="5" Click="Number_Click"/>
        <Button Content="6" Grid.Column="2" Grid.Row="2" Margin="5" Click="Number_Click"/>
        <Button Content="-" Grid.Column="3" Grid.Row="2" Margin="5" Click="Number_Click"/>
        <!-- buttons for operations-->
        <Button Content="Calculate" Grid.Column="4" Grid.Row="4" Margin="5" Click="Calculate_Click"
        
    </Grid>
</Window>
